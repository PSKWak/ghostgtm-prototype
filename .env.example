# fixture: every page and test works with no API key. live: calls a hosted model.
LLM_MODE=fixture
# Which model family live mode uses: anthropic (default, claude-opus-5-5) or groq (openai/gpt-oss-120b).
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
GROQ_API_KEY=
# Leave empty to use embedded PGlite in .data/pglite. Set to use a real Postgres.
DATABASE_URL=
